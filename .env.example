DISCORD_TOKEN=replace-with-your-bot-token
LOG_LEVEL=INFO
LLM_BASE_URL=http://host.docker.internal:20128/v1/chat/completions
LLM_MODEL=oc/deepseek-v4-flash-free(max)
# Allow time for routed models to queue and answer concurrent summary requests.
LLM_TIMEOUT=120
# Set this if 9router requires an API key for the chat completions endpoint.
LLM_API_KEY=
IEEE_API_KEY=replace-with-your-ieee-api-key
ELSEVIER_API_KEY=replace-with-your-elsevier-api-key
